export
fn t_for_untouched() -> reg u32 {
  inline int i;
  reg u32 r;
  r = 0;
  for i = 0 to 5 {
    r += i;
  }
  return r;
}

export
fn t_for_write_counter() -> reg u32 {
  inline int i;
  reg u32 r;
  r = 0;
  for i = 0 to 5 {
    r += i;
    i = 0;
  }
  return r;
}

export
fn t_for_downto_write_counter() -> reg u32 {
  inline int i;
  reg u32 r;
  r = 0;
  for i = 5 downto 0 {
    r += i;
    i = 1;
  }
  return r;
}

export
fn t_for_nested_write_outer() -> reg u32 {
  inline int i j;
  reg u32 k;
  k = 0;
  for i = 0 to 3 {
    for j = 0 to 3 {
      k += 1;
      i = 0;
    }
  }
  return k;
}

export
fn t_for_reused_counter() -> reg u32 {
  inline int i;
  reg u32 k;
  k = 0;
  for i = 0 to 3 {
    for i = 0 to 3 {
      k += 1;
    }
  }
  return k;
}
