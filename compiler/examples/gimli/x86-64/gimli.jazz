inline
fn rol32(reg u32 in, inline int cnt) -> reg u32 {
  in <<r = cnt;
  return in;
}

inline
fn and32(reg u32 x y) -> reg u32 {
  x = x;
  x &= y;
  return x;
}

inline
fn or32(reg u32 x y) -> reg u32 {
  x = x;
  x |= y;
  return x;
}

inline
fn xor32(reg u32 x y) -> reg u32 {
  x = x;
  x ^= y;
  return x;
}

inline
fn xor_shift(reg u32 x y, inline int cnt) -> reg u32 {
  x = x; y = y;
  y <<= cnt;
  x ^= y;
  return x;
}

inline
fn xor_round_constant(reg ptr u32[12] state, reg u32 _rc, inline int round) -> reg ptr u32[12] {
  state[0] ^= 0x9e377900 + round;
  return state;
}

require "../common/gimli.jinc"
