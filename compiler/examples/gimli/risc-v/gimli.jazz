inline
fn rol32(reg u32 in, inline int cnt)  -> reg u32 {
    reg u32 u l ret;
    u = in << cnt;
    l = in >> (32 - cnt);
    ret = u | l;
    return ret;
}

inline
fn xor_shift(reg u32 x y, inline int cnt) -> reg u32 {
  reg u32 z = y << cnt;
  x ^= z;
  return x;
}

require "../common/lib.jinc"
require "../common/gimli.jinc"
