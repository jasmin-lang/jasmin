// [y] points to a sub-array of the global [g] at a variable index: its mask
// is the fill of the bytes of the sub-array that lie within [g], and the
// initialisation test of [y[1]] becomes a condition on the index.
u64[4] g = {1, 2, 3, 4};

fn sum() -> reg u64
{
    inline int i;
    reg ptr u64[2] y;
    reg u64 r t;
    r = 0;
    for i = 0 to 3 {
      y = g[i:2];
      t = y[1];
      r += t;
    }
    return r;
}
