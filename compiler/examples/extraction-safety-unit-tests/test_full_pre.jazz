// The precondition states that [x] is initialised: the reads of [x] need no
// initialisation test, only the bounds of the accesses in the loop remain.
#[safety =
   { requires = is_arr_init(x,0,32) }
 ]
fn sum(reg ptr u64[4] x) -> reg u64
{
    reg u64 r;
    inline int i;
    r = x[0];
    r += x[3];
    for i = 1 to 3 {
      r += x[i];
    }
    return r;
}
