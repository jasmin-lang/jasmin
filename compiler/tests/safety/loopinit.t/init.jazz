// The same loop without ArrayInit: d stays defined.
export fn g(reg u64 p) -> reg u64 {
  stack u64[1] a b d;
  stack u8[1] c;
  reg u64 x;
  a = #randombytes(a);
  b = #randombytes(b);
  d = #randombytes(d);
  x = 0;
  while {
    c = #randombytes(c);
  } (c[0] != 0) {
    x = d[0];
    d = b;
    b = a;
  }
  [p + 0] = x;
  return x;
}
