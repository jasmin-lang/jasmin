// The loop of loop.jazz with pointers to slices: with off = 1, the third
// iteration reads b[0] = s[1], which is not initialized.
export fn g(reg u64 p) -> reg u64 {
  reg ptr u64[1] a b;
  stack u64[2] s t;
  stack u8[1] c;
  reg u64 x off;
  s[0] = 7;
  t[0] = 7;
  t[1] = 8;
  off = [p + 8];
  off &= 1;
  a = t[off : 1];
  b = t[off : 1];
  x = 0;
  while {
    c = #randombytes(c);
  } (c[0] != 0) {
    x = b[0];
    b = a;
    a = s[off : 1];
  }
  [p + 0] = x;
  return x;
}
