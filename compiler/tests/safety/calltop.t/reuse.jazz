// The call in the loop is analysed once, and its abstraction is reused at the
// next iterations. f's result is in [0; 3].
fn f(reg u64 x) -> reg u64 {
  x += 1;
  x &= 3;
  return x;
}

export fn g(reg u64 p) -> reg u64 {
  stack u64[4] t;
  reg u64 a s;
  inline int i;
  for i = 0 to 4 { t[i] = i; }
  a = [p + 0];
  s = 0;
  for i = 0 to 3 {
    a = f(a);
    s += t[a];
  }
  return s;
}
