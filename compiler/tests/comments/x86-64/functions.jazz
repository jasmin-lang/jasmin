#[comment = "inline function: no label of its own"]
inline
fn twice(reg u64 x) -> reg u64 {
  x <<= 1;
  return x;
}

#[comment = "local function"]
fn incr(reg u64 x) -> reg u64 {
  #[comment = "first statement"] x += 1;
  return x;
}

#[comment = 
"export with a stack frame
second line"
]
export
fn framed(reg u64 x) -> reg u64 {
  stack u64[1] s;
  s[0] = x;
  x = twice(x);
  x = incr(x);
  x += s[0];
  return x;
}

#[comment = "export without a stack frame"]
export
fn frameless(reg u64 x) -> reg u64 {
  #[comment = "first statement"] x += 1;
  return x;
}

#[comment = "two", comment = 3, comment = "comments"]
export
fn several(reg u64 x) -> reg u64 {
  #[comment = "on a declaration"] reg u64 y;
  y = x;
  return y;
}
