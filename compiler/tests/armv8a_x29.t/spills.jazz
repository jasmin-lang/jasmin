/* 29 values live at once, and the pointer they are loaded through. */
export fn spills(reg u64 p) -> reg u64 {
  reg u64 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 r;
  x0 = [:u64 p + 0];
  x1 = [:u64 p + 8];
  x2 = [:u64 p + 16];
  x3 = [:u64 p + 24];
  x4 = [:u64 p + 32];
  x5 = [:u64 p + 40];
  x6 = [:u64 p + 48];
  x7 = [:u64 p + 56];
  x8 = [:u64 p + 64];
  x9 = [:u64 p + 72];
  x10 = [:u64 p + 80];
  x11 = [:u64 p + 88];
  x12 = [:u64 p + 96];
  x13 = [:u64 p + 104];
  x14 = [:u64 p + 112];
  x15 = [:u64 p + 120];
  x16 = [:u64 p + 128];
  x17 = [:u64 p + 136];
  x18 = [:u64 p + 144];
  x19 = [:u64 p + 152];
  x20 = [:u64 p + 160];
  x21 = [:u64 p + 168];
  x22 = [:u64 p + 176];
  x23 = [:u64 p + 184];
  x24 = [:u64 p + 192];
  x25 = [:u64 p + 200];
  x26 = [:u64 p + 208];
  x27 = [:u64 p + 216];
  x28 = [:u64 p + 224];
  r = x0;
  r ^= x1;
  r ^= x2;
  r ^= x3;
  r ^= x4;
  r ^= x5;
  r ^= x6;
  r ^= x7;
  r ^= x8;
  r ^= x9;
  r ^= x10;
  r ^= x11;
  r ^= x12;
  r ^= x13;
  r ^= x14;
  r ^= x15;
  r ^= x16;
  r ^= x17;
  r ^= x18;
  r ^= x19;
  r ^= x20;
  r ^= x21;
  r ^= x22;
  r ^= x23;
  r ^= x24;
  r ^= x25;
  r ^= x26;
  r ^= x27;
  r ^= x28;
  return r;
}
