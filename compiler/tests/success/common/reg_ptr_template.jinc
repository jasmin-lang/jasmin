fn foo () -> reg usize {
  stack usize[N] s1 s2;
  reg ptr usize[N] ps1 ps2;
  reg usize i n z x;

  z = 0; i = 0; n = N;
  ps1 = s1; ps2 = s2;
  while (i < n) {
    ps1[i] = z;
    ps2[i] = z;
    i += 1;
  }
  x = ps1[0];
  n = ps2[0];
  x += n;
  return x;
}

export fn main() -> reg usize {
  reg usize r;
  r = foo();
  return r;
}
