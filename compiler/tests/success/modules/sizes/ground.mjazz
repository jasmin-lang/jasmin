param int k = 1 << 3;
param int z = 0;
param int w = (z - 3) / 2 + 3;

module M1 with param int n; {
  fn id(reg ptr u64[n] a) -> reg ptr u64[n] { return a; }
}

module A = M1(k / 4);
module B = M1((z - 3) / 2 + 3);

fn shift(reg ptr u64[k] a) -> reg ptr u64[8] { return a; }
fn view(reg ptr u64[k / 4] a) -> reg ptr u8[16] { return a; }
fn back(reg ptr u8[16] a) -> reg ptr u64[2] {
  reg ptr u64[2] b;
  b = a;
  return b;
}
fn floor_param(reg ptr u64[w] a) -> reg ptr u64[1] { return a; }
fn floor_arg(reg ptr u64[2] a, reg ptr u64[1] b) -> reg ptr u64[2], reg ptr u64[1] {
  a = A::id(a);
  b = B::id(b);
  return a, b;
}
