/* Parameters of kind stack narrower than a pointer, beyond the six argument
   registers of the x86-64 ABI: the caller leaves each of them in an
   eight-byte slot, of which only the declared width is meaningful, and the
   prologue moves that width into the frame of the function. */
export
fn narrow_stack_args(reg u64 a b c d e f, stack u32 p, stack u8 q, stack u16 s)
    -> reg u64 {
  reg u64 r t;
  r = a;
  r += b;
  r += c;
  r += d;
  r += e;
  r += f;
  t = (64u) p;
  r += t;
  t = (64u) q;
  r += t;
  t = (64u) s;
  r += t;
  return r;
}
