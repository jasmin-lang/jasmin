/* A stack frame, but no callee-saved register is used, so the stack pointer
   the caller had is kept in a register; the parameter of kind stack, which
   the caller leaves on the stack, is read through that register and stored in
   the frame through a temporary of the linearization — the saving register
   must therefore not be that temporary.
   The frame comes from the spilled parameter alone: a function that has a
   parameter of kind stack is never in the SavedStackNone mode of
   stack_args_saved_none.jazz. */
export
fn stack_args_frame(reg u64 a b c d e f, stack u64 g) -> reg u64 {
  reg u64 r t;
  r = a;
  r += b;
  r += c;
  r += d;
  r += e;
  r += f;
  t = g;
  r += t;
  return r;
}
