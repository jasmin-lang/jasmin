export
fn test_min_si64(reg si64 a b) -> reg si64 {
	reg si64 r;

	r = min(a,b);

	return r;
}

export
fn test_max_si64(reg si64 a b) -> reg si64 {
	reg si64 r;

	r = max(a,b);

	return r;
}

export
fn test_min_u64(reg u64 a b) -> reg u64 {
	reg u64 r;

	r = min(a,b);

	return r;
}

export
fn test_max_u64(reg u64 a b) -> reg u64 {
	reg u64 r;

	r = max(a,b);

	return r;
}

export
fn test_min_ui64(reg ui64 a b) -> reg ui64 {
	reg ui64 r;

	r = min(a,b);

	return r;
}

export
fn test_max_ui64(reg ui64 a b) -> reg ui64 {
	reg ui64 r;

	r = max(a,b);

	return r;
}

export
fn test_min_max_cst_ui64() -> reg ui64 {
	reg ui64 r;
	r = min(25,5) + max(10,30);
	return r;
}

