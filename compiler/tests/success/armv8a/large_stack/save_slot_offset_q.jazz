/* One callee-saved SIMD&FP register (v8) whose save slot is at SP + 65536:
   a multiple of 4096 (an ADD immediate) but out of the range of LDR and
   STR of a Q register (a multiple of 16 up to 65520). The 25 vectors live
   across the loop outnumber the 24 caller-saved SIMD&FP registers. */
export fn one_saved_q(reg u64 p) -> reg u64 {
  stack u8[65536] buf;
  reg u128 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24;
  reg u64 i lim;
  a0 = [:u128 p + 0];
  a1 = [:u128 p + 16];
  a2 = [:u128 p + 32];
  a3 = [:u128 p + 48];
  a4 = [:u128 p + 64];
  a5 = [:u128 p + 80];
  a6 = [:u128 p + 96];
  a7 = [:u128 p + 112];
  a8 = [:u128 p + 128];
  a9 = [:u128 p + 144];
  a10 = [:u128 p + 160];
  a11 = [:u128 p + 176];
  a12 = [:u128 p + 192];
  a13 = [:u128 p + 208];
  a14 = [:u128 p + 224];
  a15 = [:u128 p + 240];
  a16 = [:u128 p + 256];
  a17 = [:u128 p + 272];
  a18 = [:u128 p + 288];
  a19 = [:u128 p + 304];
  a20 = [:u128 p + 320];
  a21 = [:u128 p + 336];
  a22 = [:u128 p + 352];
  a23 = [:u128 p + 368];
  a24 = [:u128 p + 384];
  lim = 65536; i = 0;
  while (i < lim) { buf[i] = (8u)i; i += 1; }
  [:u128 p + 384] = a0;
  [:u128 p + 368] = a1;
  [:u128 p + 352] = a2;
  [:u128 p + 336] = a3;
  [:u128 p + 320] = a4;
  [:u128 p + 304] = a5;
  [:u128 p + 288] = a6;
  [:u128 p + 272] = a7;
  [:u128 p + 256] = a8;
  [:u128 p + 240] = a9;
  [:u128 p + 224] = a10;
  [:u128 p + 208] = a11;
  [:u128 p + 192] = a12;
  [:u128 p + 176] = a13;
  [:u128 p + 160] = a14;
  [:u128 p + 144] = a15;
  [:u128 p + 128] = a16;
  [:u128 p + 112] = a17;
  [:u128 p + 96] = a18;
  [:u128 p + 80] = a19;
  [:u128 p + 64] = a20;
  [:u128 p + 48] = a21;
  [:u128 p + 32] = a22;
  [:u128 p + 16] = a23;
  [:u128 p + 0] = a24;
  i -= 1;
  lim = (64u)buf[i];
  return lim;
}

/* Callee-saved Q registers (v8-v14) and X registers (x19-x22) in the same
   save area, at SP + 65536: every save goes through X17. */
export fn saved_q_and_x(reg u64 p) -> reg u64 {
  stack u8[65536] buf;
  reg u128 a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30;
  reg u64 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19;
  reg u64 i lim;
  a0 = [:u128 p + 0];
  a1 = [:u128 p + 16];
  a2 = [:u128 p + 32];
  a3 = [:u128 p + 48];
  a4 = [:u128 p + 64];
  a5 = [:u128 p + 80];
  a6 = [:u128 p + 96];
  a7 = [:u128 p + 112];
  a8 = [:u128 p + 128];
  a9 = [:u128 p + 144];
  a10 = [:u128 p + 160];
  a11 = [:u128 p + 176];
  a12 = [:u128 p + 192];
  a13 = [:u128 p + 208];
  a14 = [:u128 p + 224];
  a15 = [:u128 p + 240];
  a16 = [:u128 p + 256];
  a17 = [:u128 p + 272];
  a18 = [:u128 p + 288];
  a19 = [:u128 p + 304];
  a20 = [:u128 p + 320];
  a21 = [:u128 p + 336];
  a22 = [:u128 p + 352];
  a23 = [:u128 p + 368];
  a24 = [:u128 p + 384];
  a25 = [:u128 p + 400];
  a26 = [:u128 p + 416];
  a27 = [:u128 p + 432];
  a28 = [:u128 p + 448];
  a29 = [:u128 p + 464];
  a30 = [:u128 p + 480];
  x0 = [:u64 p + 496];
  x1 = [:u64 p + 504];
  x2 = [:u64 p + 512];
  x3 = [:u64 p + 520];
  x4 = [:u64 p + 528];
  x5 = [:u64 p + 536];
  x6 = [:u64 p + 544];
  x7 = [:u64 p + 552];
  x8 = [:u64 p + 560];
  x9 = [:u64 p + 568];
  x10 = [:u64 p + 576];
  x11 = [:u64 p + 584];
  x12 = [:u64 p + 592];
  x13 = [:u64 p + 600];
  x14 = [:u64 p + 608];
  x15 = [:u64 p + 616];
  x16 = [:u64 p + 624];
  x17 = [:u64 p + 632];
  x18 = [:u64 p + 640];
  x19 = [:u64 p + 648];
  lim = 65536; i = 0;
  while (i < lim) { buf[i] = (8u)i; i += 1; }
  [:u128 p + 480] = a0;
  [:u128 p + 464] = a1;
  [:u128 p + 448] = a2;
  [:u128 p + 432] = a3;
  [:u128 p + 416] = a4;
  [:u128 p + 400] = a5;
  [:u128 p + 384] = a6;
  [:u128 p + 368] = a7;
  [:u128 p + 352] = a8;
  [:u128 p + 336] = a9;
  [:u128 p + 320] = a10;
  [:u128 p + 304] = a11;
  [:u128 p + 288] = a12;
  [:u128 p + 272] = a13;
  [:u128 p + 256] = a14;
  [:u128 p + 240] = a15;
  [:u128 p + 224] = a16;
  [:u128 p + 208] = a17;
  [:u128 p + 192] = a18;
  [:u128 p + 176] = a19;
  [:u128 p + 160] = a20;
  [:u128 p + 144] = a21;
  [:u128 p + 128] = a22;
  [:u128 p + 112] = a23;
  [:u128 p + 96] = a24;
  [:u128 p + 80] = a25;
  [:u128 p + 64] = a26;
  [:u128 p + 48] = a27;
  [:u128 p + 32] = a28;
  [:u128 p + 16] = a29;
  [:u128 p + 0] = a30;
  [:u64 p + 648] = x0;
  [:u64 p + 640] = x1;
  [:u64 p + 632] = x2;
  [:u64 p + 624] = x3;
  [:u64 p + 616] = x4;
  [:u64 p + 608] = x5;
  [:u64 p + 600] = x6;
  [:u64 p + 592] = x7;
  [:u64 p + 584] = x8;
  [:u64 p + 576] = x9;
  [:u64 p + 568] = x10;
  [:u64 p + 560] = x11;
  [:u64 p + 552] = x12;
  [:u64 p + 544] = x13;
  [:u64 p + 536] = x14;
  [:u64 p + 528] = x15;
  [:u64 p + 520] = x16;
  [:u64 p + 512] = x17;
  [:u64 p + 504] = x18;
  [:u64 p + 496] = x19;
  i -= 1; lim = (64u)buf[i];
  return lim;
}
