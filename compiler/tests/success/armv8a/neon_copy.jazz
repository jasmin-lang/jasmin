// NEON copies between lanes and general registers, through their
// intrinsics, in every arrangement that the architecture allows: DUP of a
// general register (VDUP) and DUP of a lane (VDUPLANE) on 8-, 16-, 32- and
// 64-bit lanes (but no 1D), INS of a general register (VINS) and of a lane
// (VINSLANE) and UMOV on 8-, 16-, 32- and 64-bit lanes, SMOV to a 64-bit
// register on 8-, 16- and 32-bit lanes. A lane index addresses a lane of a
// whole 128-bit register, from 0 to 15, 7, 3 or 1 for 8-, 16-, 32- and
// 64-bit lanes; each instruction is used at both bounds. In the arguments,
// as in the assembly, each index follows the register it refers to:
// #VINS_4u32(c, 1, w) is ins v.s[1], w and #VINSLANE_4u32(c, 1, a, 3) is
// ins v.s[1], a.s[3]. The general register of an 8-, 16- or 32-bit lane
// is a W register, which the intrinsics truncate to the lane (DUP, INS) or
// which receives the lane zero-extended (UMOV).

// 128-bit vectors: .16b, .8h, .4s, .2d.
export
fn neon_copy(reg u64 p) {
    reg u128 a c;
    reg u32 w;
    reg u64 x;

    a = [:u128 p];
    w = [:u32 p + 16];
    x = [:u64 p + 24];

    c = #VDUP_16u8(w);
    c = #VINS_16u8(c, 0, w);
    c = #VINS_16u8(c, 15, w);
    c = #VINSLANE_16u8(c, 0, a, 15);
    c = #VINSLANE_16u8(c, 15, a, 0);
    [:u128 p + 32] = c;
    c = #VDUP_8u16(w);
    c = #VINS_8u16(c, 0, w);
    c = #VINS_8u16(c, 7, w);
    c = #VINSLANE_8u16(c, 0, a, 7);
    c = #VINSLANE_8u16(c, 7, a, 0);
    [:u128 p + 48] = c;
    c = #VDUP_4u32(w);
    c = #VINS_4u32(c, 0, w);
    c = #VINS_4u32(c, 3, w);
    c = #VINSLANE_4u32(c, 0, a, 3);
    c = #VINSLANE_4u32(c, 3, a, 0);
    [:u128 p + 64] = c;
    c = #VDUP_2u64(x);
    c = #VINS_2u64(c, 0, x);
    c = #VINS_2u64(c, 1, x);
    c = #VINSLANE_2u64(c, 0, a, 1);
    c = #VINSLANE_2u64(c, 1, a, 0);
    [:u128 p + 80] = c;

    c = #VDUPLANE_16u8(a, 0);
    [:u128 p + 96] = c;
    c = #VDUPLANE_16u8(a, 15);
    [:u128 p + 112] = c;
    c = #VDUPLANE_8u16(a, 0);
    [:u128 p + 128] = c;
    c = #VDUPLANE_8u16(a, 7);
    [:u128 p + 144] = c;
    c = #VDUPLANE_4u32(a, 0);
    [:u128 p + 160] = c;
    c = #VDUPLANE_4u32(a, 3);
    [:u128 p + 176] = c;
    c = #VDUPLANE_2u64(a, 0);
    [:u128 p + 192] = c;
    c = #VDUPLANE_2u64(a, 1);
    [:u128 p + 208] = c;

    w = (32u)#VUMOV_16u8(a, 0);
    [:u32 p + 224] = w;
    w = (32u)#VUMOV_16u8(a, 15);
    [:u32 p + 228] = w;
    w = (32u)#VUMOV_8u16(a, 0);
    [:u32 p + 232] = w;
    w = (32u)#VUMOV_8u16(a, 7);
    [:u32 p + 236] = w;
    w = #VUMOV_4u32(a, 0);
    [:u32 p + 240] = w;
    w = #VUMOV_4u32(a, 3);
    [:u32 p + 244] = w;
    x = #VUMOV_2u64(a, 0);
    [:u64 p + 248] = x;
    x = #VUMOV_2u64(a, 1);
    [:u64 p + 256] = x;
    x = (64u)#VUMOV_8u16(a, 5);
    [:u64 p + 264] = x;

    x = #VSMOV_16u8(a, 0);
    [:u64 p + 272] = x;
    x = #VSMOV_16u8(a, 15);
    [:u64 p + 280] = x;
    x = #VSMOV_8u16(a, 0);
    [:u64 p + 288] = x;
    x = #VSMOV_8u16(a, 7);
    [:u64 p + 296] = x;
    x = #VSMOV_4u32(a, 0);
    [:u64 p + 304] = x;
    x = #VSMOV_4u32(a, 3);
    [:u64 p + 312] = x;
}

// 64-bit vectors: .8b, .4h, .2s. DUP writes the low half of the vector
// register and zeroes its upper half: the result, cast to u128, is the
// whole register. The lane of DUP (element) is still a lane of a whole
// 128-bit register.
export
fn neon_copy64(reg u64 p) {
    reg u128 a c;
    reg u32 w;

    a = [:u128 p];
    w = [:u32 p + 16];

    c = (128u)#VDUP_8u8(w);
    [:u128 p + 32] = c;
    c = (128u)#VDUP_4u16(w);
    [:u128 p + 48] = c;
    c = (128u)#VDUP_2u32(w);
    [:u128 p + 64] = c;
    c = (128u)#VDUPLANE_8u8(a, 0);
    [:u128 p + 80] = c;
    c = (128u)#VDUPLANE_8u8(a, 15);
    [:u128 p + 96] = c;
    c = (128u)#VDUPLANE_4u16(a, 0);
    [:u128 p + 112] = c;
    c = (128u)#VDUPLANE_4u16(a, 7);
    [:u128 p + 128] = c;
    c = (128u)#VDUPLANE_2u32(a, 0);
    [:u128 p + 144] = c;
    c = (128u)#VDUPLANE_2u32(a, 3);
    [:u128 p + 160] = c;
}

// The lane index is a compile-time constant: the sum of the lanes of a
// vector, by an unrolled loop over the index.
export
fn neon_copy_sum(reg u128 v) -> reg u32 {
    inline int i;
    reg u32 s t;
    s = 0;
    for i = 0 to 4 {
        t = #VUMOV_4u32(v, i);
        s += t;
    }
    return s;
}

// Operations on vector and general register arguments: a lane exchange
// through a general register, and a broadcast.
export
fn neon_copy_args(reg u128 x y, reg u64 z) -> reg u128, reg u128 {
    reg u64 t;
    t = #VUMOV_2u64(x, 1);
    y = #VINS_2u64(y, 0, t);
    x = #VINSLANE_2u64(x, 1, y, 1);
    y = #VDUP_2u64(z);
    return x, y;
}
