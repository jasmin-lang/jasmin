export
fn add(reg u64 arg0, reg u64 arg1) -> reg u64 {
    reg u64 x;

    // Registers.
    x = arg0 + arg1;

    // Immediates.
    x = x + 1;
    x = x + 4095;          // Largest imm12.
    x = x + 0x1000;        // imm12, LSL #12.
    x = x + 0xfff000;      // Largest imm12, LSL #12.
    x = x + 0xdeadbeef;    // Needs a MOVZ/MOVK sequence.

    // Shifted registers.
    x = x + (arg1 << 2);
    x = x + (arg1 >> 3);
    x = x + (arg1 >>s 4);

    return x;
}
