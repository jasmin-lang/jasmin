u64 g64 = 0x0102030405060708;
u32 g32 = 0x8090a0b0;
u16 g16 = 0x8182;
u8 g8 = 0x83;
u32[4] t = { 1, 2, 3, 4 };
u64[4] u = { 5, 6, 7, 8 };

export
fn read64() -> reg u64 {
    reg u64 r;
    r = g64;
    return r;
}

export
fn read32() -> reg u32 {
    reg u32 r x;
    r = g32;
    x = t[2];
    r += x;
    return r;
}

export
fn read_narrow() -> reg u64 {
    reg u64 r s;
    reg u32 a b;
    r = (64u) g8;
    s = (64s) g8;
    r += s;
    s = (64u) g16;
    r += s;
    s = (64s) g16;
    r += s;
    s = (64s) g32;
    r += s;
    a = (32u) g8;
    b = (32s) g16;
    a += b;
    s = (64u) a;
    r += s;
    return r;
}

fn sum(reg ptr u64[4] p) -> reg u64 {
    reg u64 r x;
    inline int i;
    r = p[0];
    for i = 1 to 4 {
        x = p[i];
        r += x;
    }
    return r;
}

export
fn read_ptr() -> reg u64 {
    reg ptr u64[4] p;
    reg u64 r;
    p = u;
    r = sum(p);
    return r;
}
