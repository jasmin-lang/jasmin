/* Bit reversal and leading-zero count. RBIT and CLZ exist in both forms. */

export
fn bitops64(reg u64 arg0) -> reg u64 {
    reg u64 x y;

    x = #RBIT(arg0);
    y = #CLZ(x);
    x = x + y;
    return x;
}

export
fn bitops32(reg u32 arg0) -> reg u32 {
    reg u32 x y;

    x = #RBIT_32(arg0);
    y = #CLZ_32(x);
    x = x + y;
    return x;
}
