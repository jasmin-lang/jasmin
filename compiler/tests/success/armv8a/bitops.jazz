/* Bit and byte reversals, leading-zero and leading-sign counts. REV32 only
   exists in the X form; RBIT, REV, REV16, CLZ and CLS exist in both forms. */

export
fn bitops64(reg u64 arg0) -> reg u64 {
    reg u64 x y;

    x = #RBIT(arg0);
    y = #CLZ(x);
    x = x + y;
    y = #CLS(x);
    x = x + y;
    y = #REV(x);
    x = x + y;
    y = #REV16(x);
    x = x + y;
    y = #REV32(x);
    x = x + y;
    return x;
}

export
fn bitops32(reg u32 arg0) -> reg u32 {
    reg u32 x y;

    x = #RBIT_32(arg0);
    y = #CLZ_32(x);
    x = x + y;
    y = #CLS_32(x);
    x = x + y;
    y = #REV_32(x);
    x = x + y;
    y = #REV16_32(x);
    x = x + y;
    return x;
}
