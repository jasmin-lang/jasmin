// NEON shifts by immediate, through their intrinsics, in every
// arrangement that the architecture allows (8-, 16-, 32- and 64-bit lanes,
// but no 1D), with the bounds of the range of the amount: 0 to esize-1 for
// the left shifts SHL and SLI, 1 to esize for the right shifts USHR, SSHR,
// SRI, USRA and SSRA. SLI, SRI, USRA and SSRA also read their destination,
// their first argument.

// 128-bit vectors: .16b, .8h, .4s, .2d.
export
fn neon_shift(reg u64 p) {
    reg u128 a c;

    a = [:u128 p];
    c = [:u128 p + 16];

    c = #VSHL_16u8(c, 0);
    c = #VSHL_16u8(c, 7);
    c = #VSHL_8u16(c, 0);
    c = #VSHL_8u16(c, 15);
    c = #VSHL_4u32(c, 0);
    c = #VSHL_4u32(c, 31);
    c = #VSHL_2u64(c, 0);
    c = #VSHL_2u64(c, 63);
    c = #VUSHR_16u8(c, 1);
    c = #VUSHR_16u8(c, 8);
    c = #VUSHR_8u16(c, 1);
    c = #VUSHR_8u16(c, 16);
    c = #VUSHR_4u32(c, 1);
    c = #VUSHR_4u32(c, 32);
    c = #VUSHR_2u64(c, 1);
    c = #VUSHR_2u64(c, 64);
    c = #VSSHR_16u8(c, 1);
    c = #VSSHR_16u8(c, 8);
    c = #VSSHR_8u16(c, 1);
    c = #VSSHR_8u16(c, 16);
    c = #VSSHR_4u32(c, 1);
    c = #VSSHR_4u32(c, 32);
    c = #VSSHR_2u64(c, 1);
    c = #VSSHR_2u64(c, 64);
    c = #VSLI_16u8(c, a, 0);
    c = #VSLI_16u8(c, a, 7);
    c = #VSLI_8u16(c, a, 0);
    c = #VSLI_8u16(c, a, 15);
    c = #VSLI_4u32(c, a, 0);
    c = #VSLI_4u32(c, a, 31);
    c = #VSLI_2u64(c, a, 0);
    c = #VSLI_2u64(c, a, 63);
    c = #VSRI_16u8(c, a, 1);
    c = #VSRI_16u8(c, a, 8);
    c = #VSRI_8u16(c, a, 1);
    c = #VSRI_8u16(c, a, 16);
    c = #VSRI_4u32(c, a, 1);
    c = #VSRI_4u32(c, a, 32);
    c = #VSRI_2u64(c, a, 1);
    c = #VSRI_2u64(c, a, 64);
    c = #VUSRA_16u8(c, a, 1);
    c = #VUSRA_16u8(c, a, 8);
    c = #VUSRA_8u16(c, a, 1);
    c = #VUSRA_8u16(c, a, 16);
    c = #VUSRA_4u32(c, a, 1);
    c = #VUSRA_4u32(c, a, 32);
    c = #VUSRA_2u64(c, a, 1);
    c = #VUSRA_2u64(c, a, 64);
    c = #VSSRA_16u8(c, a, 1);
    c = #VSSRA_16u8(c, a, 8);
    c = #VSSRA_8u16(c, a, 1);
    c = #VSSRA_8u16(c, a, 16);
    c = #VSSRA_4u32(c, a, 1);
    c = #VSSRA_4u32(c, a, 32);
    c = #VSSRA_2u64(c, a, 1);
    c = #VSSRA_2u64(c, a, 64);

    [:u128 p + 32] = c;
}

// 64-bit vectors: .8b, .4h, .2s. They operate on the low halves of the
// vector registers and zero the upper halves: the result, cast to u128, is
// the whole register.
export
fn neon_shift64(reg u64 p) {
    reg u128 a c;

    a = [:u128 p];
    c = [:u128 p + 16];

    c = (128u)#VSHL_8u8(c, 0);
    c = (128u)#VSHL_8u8(c, 7);
    c = (128u)#VSHL_4u16(c, 0);
    c = (128u)#VSHL_4u16(c, 15);
    c = (128u)#VSHL_2u32(c, 0);
    c = (128u)#VSHL_2u32(c, 31);
    c = (128u)#VUSHR_8u8(c, 1);
    c = (128u)#VUSHR_8u8(c, 8);
    c = (128u)#VUSHR_4u16(c, 1);
    c = (128u)#VUSHR_4u16(c, 16);
    c = (128u)#VUSHR_2u32(c, 1);
    c = (128u)#VUSHR_2u32(c, 32);
    c = (128u)#VSSHR_8u8(c, 1);
    c = (128u)#VSSHR_8u8(c, 8);
    c = (128u)#VSSHR_4u16(c, 1);
    c = (128u)#VSSHR_4u16(c, 16);
    c = (128u)#VSSHR_2u32(c, 1);
    c = (128u)#VSSHR_2u32(c, 32);
    c = (128u)#VSLI_8u8(c, a, 0);
    c = (128u)#VSLI_8u8(c, a, 7);
    c = (128u)#VSLI_4u16(c, a, 0);
    c = (128u)#VSLI_4u16(c, a, 15);
    c = (128u)#VSLI_2u32(c, a, 0);
    c = (128u)#VSLI_2u32(c, a, 31);
    c = (128u)#VSRI_8u8(c, a, 1);
    c = (128u)#VSRI_8u8(c, a, 8);
    c = (128u)#VSRI_4u16(c, a, 1);
    c = (128u)#VSRI_4u16(c, a, 16);
    c = (128u)#VSRI_2u32(c, a, 1);
    c = (128u)#VSRI_2u32(c, a, 32);
    c = (128u)#VUSRA_8u8(c, a, 1);
    c = (128u)#VUSRA_8u8(c, a, 8);
    c = (128u)#VUSRA_4u16(c, a, 1);
    c = (128u)#VUSRA_4u16(c, a, 16);
    c = (128u)#VUSRA_2u32(c, a, 1);
    c = (128u)#VUSRA_2u32(c, a, 32);
    c = (128u)#VSSRA_8u8(c, a, 1);
    c = (128u)#VSSRA_8u8(c, a, 8);
    c = (128u)#VSSRA_4u16(c, a, 1);
    c = (128u)#VSSRA_4u16(c, a, 16);
    c = (128u)#VSSRA_2u32(c, a, 1);
    c = (128u)#VSSRA_2u32(c, a, 32);

    [:u128 p + 32] = c;
}

// Shifts of vector arguments, results in V registers.
export
fn neon_shift_args(reg u128 x y) -> reg u128, reg u128 {
    reg u128 z w;
    z = #VSHL_4u32(x, 3);
    w = (128u)#VUSHR_4u16(y, 5);
    z = #VSRI_8u16(z, w, 5);
    w = #VSSRA_2u64(w, x, 63);
    return z, w;
}
