// NEON shifts by register USHL and SSHL, through their intrinsics, in every
// arrangement that the architecture allows (8-, 16-, 32- and 64-bit lanes,
// but no 1D). Each lane of the first argument is shifted by the signed low
// byte of the same lane of the second one: to the left if it is
// nonnegative, to the right otherwise.

// 128-bit vectors: .16b, .8h, .4s, .2d.
export
fn neon_shift_reg(reg u64 p) {
    reg u128 a c;

    a = [:u128 p];
    c = [:u128 p + 16];

    c = #VUSHL_16u8(c, a);
    c = #VUSHL_8u16(c, a);
    c = #VUSHL_4u32(c, a);
    c = #VUSHL_2u64(c, a);
    c = #VSSHL_16u8(c, a);
    c = #VSSHL_8u16(c, a);
    c = #VSSHL_4u32(c, a);
    c = #VSSHL_2u64(c, a);

    [:u128 p + 32] = c;
}

// 64-bit vectors: .8b, .4h, .2s. They operate on the low halves of the
// vector registers and zero the upper halves: the result, cast to u128, is
// the whole register.
export
fn neon_shift_reg64(reg u64 p) {
    reg u128 a c;

    a = [:u128 p];
    c = [:u128 p + 16];

    c = (128u)#VUSHL_8u8(c, a);
    c = (128u)#VUSHL_4u16(c, a);
    c = (128u)#VUSHL_2u32(c, a);
    c = (128u)#VSSHL_8u8(c, a);
    c = (128u)#VSSHL_4u16(c, a);
    c = (128u)#VSSHL_2u32(c, a);

    [:u128 p + 32] = c;
}

// Shift counts computed at run time: each 32-bit lane of the first vector
// is shifted to the left by the count of its lane and back to the right by
// the negated count.
export
fn neon_shift_reg_args(reg u128 x n) -> reg u128 {
    reg u128 m y;
    y = #VUSHL_4u32(x, n);
    m = #VNEG_4u32(n);
    y = #VSSHL_4u32(y, m);
    return y;
}
