// The lane-wise arithmetic operators on u128 compile to the NEON
// instructions with the same lanes: + to ADD, - to SUB and * to MUL
// (which has no 64-bit lanes).

export
fn neon_arith_ops(reg u64 p) {
    reg u128 a b c d;
    stack u128 s;

    a = [:u128 p];
    b = [:u128 p + 16];
    c = [:u128 p + 32];
    s = c;

    c = a +16u8 b;      // ADD .16b
    c = c +8u16 b;      // ADD .8h
    c = c +4u32 b;      // ADD .4s
    c = c +2u64 b;      // ADD .2d
    c = c -16u8 a;      // SUB .16b
    c = c -8u16 a;      // SUB .8h
    c = c -4u32 a;      // SUB .4s
    c = c -2u64 a;      // SUB .2d
    c = c *16u8 b;      // MUL .16b
    c = c *8u16 b;      // MUL .8h
    c = c *4u32 b;      // MUL .4s
    d = s;
    c = c +4u32 d;
    d = [:u128 p + 48];
    c = c -2u64 d;

    [:u128 p + 64] = c;
}

// Operators on vector arguments, results in V registers.
export
fn neon_arith_ops_args(reg u128 x y) -> reg u128, reg u128 {
    reg u128 z w;
    z = x +4u32 y;
    w = x *8u16 y;
    z = z -16u8 w;
    return z, w;
}
