/* Advanced SIMD permutations and element moves. */
export
fn simd_permute(reg u64 p) -> reg u64 {
    reg u128 a b c;
    reg u32 w;
    reg u64 x;
    a = [:u128 p];
    b = [:u128 p + 16];
    c = #VEXT(a, b, 8);
    c = #VEXT(c, b, 0);
    c = #VEXT(c, a, 15);
    c = #VREV32_16u8(c);
    c = #VREV64_4u32(c);
    c = #VTRN1_4u32(c, a);
    c = #VTRN2_2u64(c, b);
    c = #VZIP1_16u8(c, a);
    c = #VZIP2_8u16(c, b);
    c = #VUZP1_4u32(c, a);
    c = #VUZP2_2u64(c, b);
    w = #VUMOV_4u32(c, 3);
    c = #VDUP_16u8(w);
    c = #VINS_4u32(c, w, 1);
    c = #VINSE_2u64(c, a, 1, 0);
    c = #VINSE_4u32(c, b, 1, 3);
    c = #VINSE_16u8(c, a, 2, 13);
    c = #VDUPE_8u16(c, 7);
    x = #VUMOV_2u64(c, 1);
    c = #VDUP_2u64(x);
    c = #VINS_2u64(c, x, 0);
    w = #VUMOV_16u8(c, 15);
    [:u128 p + 32] = c;
    [:u32 p + 48] = w;
    return x;
}
