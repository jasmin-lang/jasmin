/* Every comparison as the condition of update_msf after an if, and some after
   a while. The condition reaches CSEL as a condition code. */

export
fn if_eq(reg u64 x y) -> reg u64 {
    reg u64 msf r;
    reg bool b;
    msf = #init_msf();
    b = x == y;
    if (b) {
        msf = #update_msf(b, msf);
        r = 1;
    } else {
        msf = #update_msf(!b, msf);
        r = 2;
    }
    r = #protect(r, msf);
    return r;
}

export
fn if_ne(reg u64 x y) -> reg u64 {
    reg u64 msf r;
    reg bool b;
    msf = #init_msf();
    b = x != y;
