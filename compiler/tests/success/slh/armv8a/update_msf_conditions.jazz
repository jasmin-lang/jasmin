export
fn while_ltu(reg u64 x y) -> reg u64 {
    reg u64 msf r;
    reg bool b;
    msf = #init_msf();
    r = 0;
    while { b = x <u y; } (b) {
        msf = #update_msf(b, msf);
        x += 1;
        r += 1;
    }
    msf = #update_msf(!b, msf);
    r = #protect(r, msf);
    return r;
}

